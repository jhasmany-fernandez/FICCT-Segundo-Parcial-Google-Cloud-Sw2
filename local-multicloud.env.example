# Backend publicado en Google Cloud o, para pruebas locales, un backend expuesto en el host.
# Evita la barra final para que el gateway preserve correctamente las rutas.
CLOUD_BACKEND_URL=http://34.122.37.25

# Backend/gateway local expuesto en la maquina host.
# Ejemplo tipico si el compose principal publica 8787 -> 8000.
LOCAL_BACKEND_URL=http://host.docker.internal:8787

# Puerto publicado por el gateway local de simulacion.
LOCAL_GATEWAY_PORT=8089

# Puerto de Prometheus si se activa el perfil observability.
LOCAL_PROMETHEUS_PORT=9091
